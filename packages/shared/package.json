{
  "name": "@meridian/shared",
  "version": "0.0.0",
  "private": true,
  "description": "The contract between the Meridian FX web app and API: types, enums, constants, formatters",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types/index.ts",
    "./constants": "./src/constants/index.ts",
    "./utils": "./src/utils/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "echo \"no lint configured for shared yet\"",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "decimal.js": "^10.4.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@meridian/config": "workspace:*",
    "@types/decimal.js": "^7.4.3",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
