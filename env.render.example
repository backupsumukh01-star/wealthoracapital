# Growzy — Render production environment checklist
# Set these on each Render service (or via render.yaml sync:false secrets).
# Replace growzycapital.com with your custom domains after DNS is attached.

# ─── Shared / Frontend (growzy-web) ───────────────────────────────────────────
NODE_ENV=production
NEXT_PUBLIC_API_URL=https://api.growzycapital.com/api/v1
NEXT_PUBLIC_SITE_URL=https://growzycapital.com
NEXT_PUBLIC_PLATFORM_NAME=Growzy
NEXT_PUBLIC_SUPPORT_EMAIL=support@growzycapital.com
NEXT_PUBLIC_ENABLE_REFERRALS=false
NEXT_PUBLIC_ENABLE_ROUTE_GUARDS=true

# ─── API (growzy-api) + Worker (growzy-worker) ────────────────────────────────
# NODE_ENV=production
APP_ENV=production
APP_NAME=Growzy
# PORT is injected by Render — do not set manually
APP_URL=https://growzycapital.com
API_URL=https://api.growzycapital.com

# From Render PostgreSQL (Internal Database URL preferred for private network)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

JWT_ACCESS_SECRET=replace-with-64-char-random-access-secret!!
JWT_REFRESH_SECRET=replace-with-64-char-random-refresh-secret!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=growzy
JWT_AUDIENCE=growzy-web

# Shared parent domain so cookies work across app + api subdomains
COOKIE_DOMAIN=.growzycapital.com
COOKIE_SECURE=true
CORS_ORIGIN=https://growzycapital.com

BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=20

EMAIL_TRANSPORT=resend
RESEND_API_KEY=re_xxxxxxxx
SMTP_FROM_NAME=Growzy
SMTP_FROM_ADDRESS=noreply@growzycapital.com

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.growzycapital.com/api/v1/auth/google/callback

# NEXTAUTH_SECRET is NOT used — auth is Express cookie JWT (mfx_at / mfx_rt)

UPLOAD_ROOT=/tmp/uploads
STORAGE_DRIVER=local

# Starter: memory drivers (no Redis/worker required)
CACHE_DRIVER=memory
JOB_DRIVER=memory
RATE_LIMIT_STORE=memory
REDIS_URL=
REDIS_REQUIRED=false

# Production scale-up (uncomment when Redis + worker services exist):
# CACHE_DRIVER=redis
# JOB_DRIVER=bullmq
# RATE_LIMIT_STORE=redis
# REDIS_REQUIRED=true
# REDIS_URL=<Render Key Value internal URL>

ENABLE_API_DOCS=true
CSRF_PROTECTION=true
METRICS_ENABLED=true
LOG_LEVEL=info

WORKER_GROUP=all
WORKER_CONCURRENCY=2
