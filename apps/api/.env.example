NODE_ENV=development
PORT=4000
APP_NAME=Growzy
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# PostgreSQL
DATABASE_URL=postgresql://meridian:meridian@localhost:5432/meridian?schema=public

# JWT — use unique secrets ≥ 32 characters in every environment
JWT_ACCESS_SECRET=change-me-to-a-32-byte-random-string-min
JWT_REFRESH_SECRET=change-me-to-a-different-32-byte-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=meridian-fx
JWT_AUDIENCE=meridian-fx-web

# Cookies
COOKIE_DOMAIN=
COOKIE_SECURE=false

# CORS — comma-separated origins
CORS_ORIGIN=http://localhost:3000

# Security
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=20

# Email (architecture ready — console transport until a provider is wired)
EMAIL_TRANSPORT=console
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Growzy
SMTP_FROM_ADDRESS=noreply@localhost

# Optional OAuth stubs (not implemented in Phase 1)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback

UPLOAD_ROOT=./uploads
STORAGE_DRIVER=local
LOG_LEVEL=info
