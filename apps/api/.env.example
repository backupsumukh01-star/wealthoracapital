# ---------------------------------------------------------------------------
# apps/api — environment template (local + Render)
# Copy to apps/api/.env for local development. On Render, set these in the
# dashboard / render.yaml — do not commit real secrets.
# ---------------------------------------------------------------------------

NODE_ENV=development
APP_ENV=development
# Render injects PORT automatically — do not hardcode in production
PORT=4000
APP_NAME=Growzy

# Public origins (production: HTTPS custom domains)
APP_URL=https://growzycapital.com
API_URL=https://api.growzycapital.com

# PostgreSQL — local docker or Render Postgres DATABASE_URL
DATABASE_URL=postgresql://meridian:meridian@127.0.0.1:5432/meridian?schema=public

# JWT — unique secrets ≥ 32 characters in every environment
JWT_ACCESS_SECRET=change-me-to-a-32-byte-random-string-min
JWT_REFRESH_SECRET=change-me-to-a-different-32-byte-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=growzy
JWT_AUDIENCE=growzy-web

# Cookies — for app.example.com + api.example.com use COOKIE_DOMAIN=.example.com
COOKIE_DOMAIN=
COOKIE_SECURE=false

# CORS — comma-separated frontend origins
CORS_ORIGIN=https://growzycapital.com

BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=20

# Email (console | smtp | resend | sendgrid | ses | mailgun)
EMAIL_TRANSPORT=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Growzy
SMTP_FROM_ADDRESS=noreply@growzycapital.com
RESEND_API_KEY=
SENDGRID_API_KEY=
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
SES_REGION=us-east-1
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
EMAIL_OUTBOX_POLL_MS=30000

# Google OAuth (optional — production callback must be HTTPS)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.growzycapital.com/api/v1/auth/google/callback

UPLOAD_ROOT=./uploads
STORAGE_DRIVER=local

# Cache / Redis / Jobs — on Render use memory unless Redis + worker are provisioned
CACHE_DRIVER=memory
JOB_DRIVER=memory
RATE_LIMIT_STORE=memory
REDIS_URL=
REDIS_REQUIRED=false

SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
METRICS_ENABLED=true
METRICS_TOKEN=
ENABLE_API_DOCS=true
CSRF_PROTECTION=true
LOG_LEVEL=info
