# ---------------------------------------------------------------------------
# apps/api — environment template (local + Render)
# Copy to apps/api/.env for local development. On Render, set these in the
# dashboard / render.yaml — do not commit real secrets.
# ---------------------------------------------------------------------------

NODE_ENV=development
APP_ENV=development
# Render injects PORT automatically — do not hardcode in production
PORT=4000
APP_NAME=Wealthora Capital

# Public origins (production: HTTPS custom domains)
APP_URL=https://growzycapital.com
API_URL=https://api.growzycapital.com

# Progress share PNGs are rendered server-side with @resvg/resvg-js (SVG → PNG).
# No extra env vars required; image routes live at /api/v1/progress-share/*.

# PostgreSQL — local docker or Render Postgres DATABASE_URL
DATABASE_URL=postgresql://meridian:meridian@127.0.0.1:5432/meridian?schema=public

# JWT — unique secrets ≥ 32 characters in every environment
JWT_ACCESS_SECRET=change-me-to-a-32-byte-random-string-min
JWT_REFRESH_SECRET=change-me-to-a-different-32-byte-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=growzy
JWT_AUDIENCE=growzy-web

# Cookies — for app.example.com + api.example.com use COOKIE_DOMAIN=.example.com
COOKIE_DOMAIN=
COOKIE_SECURE=false

# CORS — comma-separated frontend origins
CORS_ORIGIN=https://growzycapital.com

BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=20

# Email (console | smtp | resend | sendgrid | ses | mailgun)
EMAIL_TRANSPORT=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Wealthora Capital
SMTP_FROM_ADDRESS=noreply@growzycapital.com
# Sender lanes (must be verified in Resend / ESP)
EMAIL_FROM_AUTH=noreply@growzycapital.com
EMAIL_FROM_SUPPORT=support@growzycapital.com
EMAIL_FROM_FINANCE=info@growzycapital.com
RESEND_API_KEY=
# Ops / owner alerts (comma-separated). Used for KYC, deposits, withdrawals,
# registrations, support, ROI, system errors, and the daily owner report.
# Example: owner@growzycapital.com,finance@growzycapital.com
ADMIN_ALERT_EMAILS=info@growzycapital.com

# Telegram ops bots (optional). Three separate bots — never commit real tokens.
# When token or chat id is empty, that bot is a no-op (finance flows still succeed).
TELEGRAM_KYC_BOT_TOKEN=
TELEGRAM_KYC_CHAT_ID=
TELEGRAM_DEPOSIT_BOT_TOKEN=
TELEGRAM_DEPOSIT_CHAT_ID=
TELEGRAM_WITHDRAWAL_BOT_TOKEN=
TELEGRAM_WITHDRAWAL_CHAT_ID=

# Abort hung HTTP handlers (ms). 0 = disabled.
REQUEST_TIMEOUT_MS=30000
# Exit process after uncaughtException so Render restarts cleanly (recommended: true in prod)
EXIT_ON_UNCAUGHT=false
SENDGRID_API_KEY=
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
SES_REGION=us-east-1
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
EMAIL_OUTBOX_POLL_MS=30000

# Google OAuth (required for Continue with Google)
# Local callback must match Google Cloud Console Authorized redirect URI exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback
# Allowlisted Google emails for operator console (Google login only — no password on /admin/login)
# SUPER_ADMIN:
GOOGLE_SUPER_ADMIN_EMAILS=
# ADMIN:
GOOGLE_ADMIN_EMAILS=
# Production:
# GOOGLE_CALLBACK_URL=https://api.growzycapital.com/api/v1/auth/google/callback
# GOOGLE_SUPER_ADMIN_EMAILS=you@gmail.com
# GOOGLE_ADMIN_EMAILS=ops@company.com
# See docs/GOOGLE_OAUTH_SETUP.md

# Market data (server-side only — never put keys in NEXT_PUBLIC_*)
# public = free delayed quotes (Frankfurter / CoinGecko / gold-api)
# Market quotes (server-side only — never put the key in NEXT_PUBLIC_*)
# public = free delayed sources
# finnhub = keyed quotes (free tier: crypto live; forex/metals often fall back to delayed public)
MARKET_DATA_PROVIDER=finnhub
MARKET_DATA_API_KEY=
MARKET_DATA_CACHE_TTL_MS=20000

# Payment provider webhooks (HMAC-SHA256 of raw JSON body)
# Header: X-Growzy-Signature: sha256=<hex>  (also accepts X-Payment-Signature / X-Nowpayments-Sig)
PAYMENT_PROVIDER=generic
PAYMENT_WEBHOOK_SECRET=
# When true, verified provider paid webhooks (OxaPay / generic) auto-credit via confirmFromProvider
# (idempotent). When false, OxaPay paid deposits queue UNDER_REVIEW for Admin Approve.
# Production OxaPay: true (verified paid gateway deposits do not need manual Approve).
PAYMENT_AUTO_CONFIRM_DEPOSITS=true
# Dev/test only — never true on internet-facing hosts with a real ledger.
PAYMENT_WEBHOOK_ALLOW_UNSIGNED=false
PAYMENT_WEBHOOK_MAX_SKEW_SECONDS=300

# OxaPay crypto gateway (do not put production keys in git)
# Docs: https://docs.oxapay.com
# Production: OXAPAY_SANDBOX=false and PAYMENT_AUTO_CONFIRM_DEPOSITS=true
OXAPAY_MERCHANT_API_KEY=
OXAPAY_SANDBOX=false
# Optional overrides (defaults: API_URL/api/v1/webhooks/oxapay and APP_URL/deposit/oxapay/return)
OXAPAY_CALLBACK_URL=
OXAPAY_RETURN_URL=
OXAPAY_API_BASE_URL=https://api.oxapay.com/v1

# Local: ./uploads
# Render (Persistent Disk mounted at /data): /data/uploads
UPLOAD_ROOT=./uploads
STORAGE_DRIVER=local
# When STORAGE_DRIVER=s3 (AWS / MinIO / R2):
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT=           # optional — set for MinIO / path-style endpoints
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=    # optional CDN/public base; else API proxies /uploads

# ---------------------------------------------------------------------------
# Production email (Render): EMAIL_TRANSPORT=resend REQUIRES these secrets:
#   RESEND_API_KEY          — from https://resend.com/api-keys
#   SMTP_FROM_ADDRESS       — verified domain sender, e.g. noreply@growzycapital.com
# Startup fails closed if either is missing in NODE_ENV=production.
# ---------------------------------------------------------------------------

# Cache / Redis / Jobs — on Render use memory unless Redis + worker are provisioned
CACHE_DRIVER=memory
JOB_DRIVER=memory
RATE_LIMIT_STORE=memory
REDIS_URL=
REDIS_REQUIRED=false

SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
METRICS_ENABLED=true
METRICS_TOKEN=
ENABLE_API_DOCS=true
CSRF_PROTECTION=true
LOG_LEVEL=info
