/// Single-row-per-key CMS document (landing / platform copy) with draft + published + scheduled state.
model CmsDocument {
  id               String         @id @default(uuid()) @db.Uuid
  key              CmsDocumentKey @unique
  status           CmsStatus      @default(DRAFT)
  draftContent     Json           @map("draft_content")
  publishedContent Json?          @map("published_content")
  scheduledContent Json?          @map("scheduled_content")
  scheduledAt      DateTime?      @map("scheduled_at")
  version          Int            @default(1)
  publishedAt      DateTime?      @map("published_at")
  updatedById      String?        @map("updated_by_id") @db.Uuid
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  revisions CmsRevision[]

  @@map("cms_documents")
}

/// Immutable version history for CMS documents — enables rollback.
model CmsRevision {
  id          String            @id @default(uuid()) @db.Uuid
  documentKey CmsDocumentKey    @map("document_key")
  document    CmsDocument       @relation(fields: [documentKey], references: [key], onDelete: Cascade)
  action      CmsRevisionAction
  version     Int
  label       String?           @db.VarChar(160)
  snapshot    Json
  actorId     String?           @map("actor_id") @db.Uuid
  createdAt   DateTime          @default(now()) @map("created_at")

  @@index([documentKey, createdAt])
  @@index([documentKey, version])
  @@map("cms_revisions")
}

