  wallet              Wallet           @relation(fields: [walletId], references: [id], onDelete: Restrict)
  payoutMethodId      String           @map("payout_method_id") @db.Uuid
  payoutMethod        PayoutMethod     @relation(fields: [payoutMethodId], references: [id], onDelete: Restrict)
  transactionId       String?          @unique @map("transaction_id") @db.Uuid
  transaction         Transaction?     @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  amount              Decimal          @db.Decimal(20, 8)
  /** INR snapshot at submission using platform desk rate (whole rupees). */
  amountInr           Decimal?         @map("amount_inr") @db.Decimal(20, 8)
  fee                 Decimal          @default(0) @db.Decimal(20, 8)
  netAmount           Decimal          @map("net_amount") @db.Decimal(20, 8)
  currency            String           @default("USD") @db.Char(3)
  status              WithdrawalStatus @default(PENDING)
  destinationLabel    String           @map("destination_label") @db.VarChar(160)
  destinationSnapshot Json             @map("destination_snapshot")
  transactionRef      String?          @map("transaction_ref") @db.VarChar(120)
  rejectionReason     String?          @map("rejection_reason") @db.VarChar(500)
  internalNotes       String?          @map("internal_notes") @db.VarChar(2000)
  otpVerifiedAt       DateTime?        @map("otp_verified_at")
  idempotencyKey      String           @unique @map("idempotency_key") @db.VarChar(120)
  reviewedById        String?          @map("reviewed_by_id") @db.Uuid
  reviewedAt          DateTime?        @map("reviewed_at")
  paidAt              DateTime?        @map("paid_at")
  createdAt           DateTime         @default(now()) @map("created_at")
