// Growzy / Meridian FX — Prisma schema
// Phase 1: identity & auth
// Phase 2: profiles, audit, activity, notifications

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum StaffRole {
  SUPER_ADMIN
  ADMIN
  FINANCE
  SUPPORT
  KYC
  CONTENT
  VIEWER
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  BLOCKED
  CLOSED
  ARCHIVED
}

enum KycStatus {
  NOT_STARTED
  PENDING
  SUBMITTED
  UNDER_REVIEW
  NEED_MORE_INFO
  APPROVED
  REJECTED
  EXPIRED
  SUSPENDED
}

enum KycDocumentType {
  PASSPORT
  NATIONAL_ID
  DRIVING_LICENSE
  RESIDENCE_PERMIT
  PROOF_OF_ADDRESS
  SELFIE
  BANK_STATEMENT
  UTILITY_BILL
}

enum KycDocumentSide {
  FRONT
  BACK
  SINGLE
}

enum KycDocumentStatus {
  UPLOADED
  VERIFIED
  REJECTED
  REPLACED
}

enum KycRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum KycReviewDecision {
  APPROVE
  REJECT
  REQUEST_INFORMATION
  EXPIRE
  REOPEN
  SUSPEND
}

enum KycHistoryAction {
  CREATED
  UPDATED
  DOCUMENT_UPLOADED
  DOCUMENT_DELETED
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  INFO_REQUESTED
  EXPIRED
  REOPENED
  SUSPENDED
  ASSIGNED
  NOTE_ADDED
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  EMAIL_CHANGE
}

enum ActivityKind {
  LOGIN
  LOGOUT
  PASSWORD_CHANGE
  EMAIL_CHANGE
  PROFILE_UPDATE
  ADMIN_ACTION
  ACCOUNT_STATUS_CHANGE
  SESSION_TERMINATED
  AVATAR_UPDATE
  REGISTRATION
  KYC_SUBMITTED
  KYC_APPROVED
  KYC_REJECTED
  KYC_INFO_REQUESTED
  KYC_EXPIRED
  KYC_SUSPENDED
  KYC_REOPENED
  DEPOSIT_SUBMITTED
  DEPOSIT_APPROVED
  DEPOSIT_REJECTED
  DEPOSIT_CANCELLED
  WITHDRAWAL_SUBMITTED
  WITHDRAWAL_APPROVED
  WITHDRAWAL_REJECTED
  WITHDRAWAL_CANCELLED
  WITHDRAWAL_PAID
  WALLET_ADJUSTMENT
  TRADE_OPENED
  TRADE_CLOSED
  TRADE_PUBLISHED
  DAILY_RETURN_APPLIED
  DISTRIBUTION_COMPLETE
  CMS_PUBLISHED
  CMS_ROLLBACK
  CMS_SCHEDULED
  MEDIA_UPLOADED
  MEDIA_DELETED
  REPORT_GENERATED
  EMAIL_TEMPLATE_UPDATED
  EMAIL_SENT
  SUPPORT_TICKET_CREATED
  SUPPORT_TICKET_REPLIED
  SUPPORT_TICKET_ASSIGNED
  SUPPORT_TICKET_CLOSED
  BROADCAST_SENT
  SETTINGS_UPDATED
  FEATURE_FLAG_UPDATED
}

enum NotificationKind {
  SYSTEM
  SECURITY
  ACCOUNT
  ADMIN
  FINANCE
  TRADING
  SUPPORT
  MARKETING
  BROADCAST
}

enum TradeStatus {
  DRAFT
  SCHEDULED
  OPEN
  RUNNING
  CLOSED
  CANCELLED
  ARCHIVED
}

enum TradeDirection {
  BUY
  SELL
}

enum TradeOutcome {
  WIN
  LOSS
  BREAKEVEN
}

enum TradeRisk {
  LOW
  MEDIUM
  HIGH
}

enum AllocationMode {
  EQUAL
  PERCENTAGE
  CAPITAL
  MANUAL
}

enum DailyReturnRunStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REVERSED
}

enum ReturnBasis {
  BALANCE
  INVESTED
}

enum TradingDayStatus {
  DRAFT
  PUBLISHED
  DISTRIBUTED
  REVERSED
}

enum TradeHistoryAction {
  CREATED
  UPDATED
  OPENED
  CLOSED
  CANCELLED
  DUPLICATED
  ARCHIVED
  PUBLISHED
  HIDDEN
  ALLOCATED
  NOTE
}

enum WalletKind {
  INVESTMENT
  PROFIT
  BONUS
  REFERRAL
}

enum LedgerAccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
  CONTRA
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  INVESTMENT
  PROFIT
  REFERRAL_BONUS
  ADMIN_ADJUSTMENT
  TRANSFER
  REFUND
  REVERSAL
}

enum TransactionStatus {
  PENDING
  POSTED
  REVERSED
  CANCELLED
  FAILED
}

enum LedgerEntryType {
  DEPOSIT_APPROVED
  WITHDRAWAL_LOCKED
  WITHDRAWAL_COMPLETED
  WITHDRAWAL_REFUNDED
  PROFIT_DISTRIBUTION
  PROFIT_REVERSAL
  ADJUSTMENT_CREDIT
  ADJUSTMENT_DEBIT
  FEE
  BONUS
  TRANSFER
  REFUND
  REVERSAL
}

enum DepositStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
}

enum WithdrawalStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  PROCESSING
  PAID
  COMPLETED
  REJECTED
  CANCELLED
}

enum PaymentMethodType {
  UPI
  BANK_TRANSFER
  CRYPTO
  MANUAL
  OTHER
  /// Legacy rails — retained for historical deposits / payouts; prefer UPI/CRYPTO going forward.
  USDT_TRC20
  USDT_BEP20
  BTC
  ETH
  MOBILE_WALLET
}

enum ApprovalQueueStatus {
  PENDING
  IN_PROGRESS
  APPROVED
  REJECTED
  CANCELLED
  ESCALATED
}

enum ApprovalRole {
  FINANCE
  ADMIN
  SUPERVISOR
}

enum FinanceReviewDecision {
  APPROVE
  REJECT
  REQUEST_INFORMATION
  FORCE_COMPLETE
  FORCE_CANCEL
  NOTE
  PAID
  PROVIDER_CONFIRM
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @unique @db.Citext
  emailVerifiedAt DateTime?  @map("email_verified_at")
  passwordHash    String?    @map("password_hash")
  /// Google subject (`sub`) — set when the account is linked via Google OAuth.
  googleId        String?    @unique @map("google_id") @db.VarChar(64)
  firstName       String     @map("first_name") @db.VarChar(60)
  lastName        String     @map("last_name") @db.VarChar(60)
  phone           String?    @db.VarChar(24)
  // Uniqueness for non-deleted phones enforced via partial unique index in migration.
  country         String?    @db.Char(2)
  timezone        String     @default("UTC")
  avatarKey       String?    @map("avatar_key")
  role            Role       @default(USER)
  staffRole       StaffRole? @map("staff_role")
  status          UserStatus @default(PENDING_VERIFICATION)
  kycStatus       KycStatus  @default(NOT_STARTED) @map("kyc_status")

  twoFactorSecret   String?   @map("two_factor_secret")
  twoFactorEnabled  Boolean   @default(false) @map("two_factor_enabled")
  failedLoginCount  Int       @default(0) @map("failed_login_count")
  lockedUntil       DateTime? @map("locked_until")
  lastLoginAt       DateTime? @map("last_login_at")
  lastLoginIp       String?   @map("last_login_ip")
  passwordChangedAt DateTime? @map("password_changed_at")

  termsAcceptedAt DateTime? @map("terms_accepted_at")
  riskAcceptedAt  DateTime? @map("risk_accepted_at")
  marketingOptIn  Boolean   @default(false) @map("marketing_opt_in")

  referralCode String? @unique @map("referral_code") @db.VarChar(16)
  referredById String? @map("referred_by_id") @db.Uuid
  referredBy   User?   @relation("Referrals", fields: [referredById], references: [id])
  referrals    User[]  @relation("Referrals")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  /// Set when an operator creates the investor from Admin → Create user.
  /// Demo accounts look like real investors to themselves; their deposits and
  /// withdrawals are hidden from admin queues and do not page operators.
  createdByAdminId String? @map("created_by_admin_id") @db.Uuid

  // UserSession — existing Session model (refresh-token sessions)
  sessions               Session[]
  verificationTokens     VerificationToken[]
  profile                UserProfile?
  auditLogsAsActor       AuditLog[]           @relation("AuditActor")
  auditLogsAsTarget      AuditLog[]           @relation("AuditTarget")
  activityLogs           ActivityLog[]        @relation("ActivitySubject")
  activityLogsAsActor    ActivityLog[]        @relation("ActivityActor")
  notifications          Notification[]
  kycSubmissions         KycSubmission[]
  kycReviewsAssigned     KycReview[]          @relation("KycReviewer")
  wallets                Wallet[]
  ledgerAccounts         LedgerAccount[]
  transactions           Transaction[]
  deposits               Deposit[]
  withdrawals            Withdrawal[]
  payoutMethods          PayoutMethod[]
  financeReviews         FinanceReview[]      @relation("FinanceReviewer")
  approvalAssignments    ApprovalQueue[]      @relation("ApprovalAssignee")
  tradeAllocations       TradeAllocation[]
  profitDistributions    ProfitDistribution[]
  investorPerformance    InvestorPerformance?
  portfolioSnapshots     PortfolioSnapshot[]
  supportTickets         SupportTicket[]      @relation("SupportUser")
  supportTicketsAssigned SupportTicket[]      @relation("SupportAssignee")
  referralRewardsEarned  ReferralReward[]      @relation("ReferralReferrer")
  referralRewardsGenerated ReferralReward[]   @relation("ReferralReferee")
  /// Sales Portal first-touch row. Adds no column on users.
  salesAttribution       SalesAttribution?

  @@index([status])
  @@index([role])
  @@index([staffRole])
  @@index([kycStatus])
  @@index([createdAt])
  @@index([country])
  @@index([phone])
  @@index([createdByAdminId])
  @@map("users")
}

/// Refresh-token session store (UserSession in product language).
model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique @map("refresh_token_hash")
  familyId         String    @map("family_id") @db.Uuid
  userAgent        String?   @map("user_agent") @db.VarChar(400)
  ip               String?
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  replacedById     String?   @map("replaced_by_id") @db.Uuid
  lastUsedAt       DateTime  @default(now()) @map("last_used_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("sessions")
}

model VerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  type      TokenType
  payload   Json?
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, type])
  @@map("verification_tokens")
}

model UserProfile {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @map("user_id") @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  addressLine1 String?  @map("address_line1") @db.VarChar(120)
  addressLine2 String?  @map("address_line2") @db.VarChar(120)
  city         String?  @db.VarChar(80)
  state        String?  @db.VarChar(80)
  postalCode   String?  @map("postal_code") @db.VarChar(24)
  language     String   @default("en") @db.VarChar(10)
  /** Display preference only — ledger remains USD. */
  displayCurrency String @default("USD") @map("display_currency") @db.Char(3)
  bio          String?  @db.VarChar(500)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("user_profiles")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorId      String?  @map("actor_id") @db.Uuid
  actor        User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  targetUserId String?  @map("target_user_id") @db.Uuid
  targetUser   User?    @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  action       String   @db.VarChar(80)
  module       String   @db.VarChar(80)
  oldValue     Json?    @map("old_value")
  newValue     Json?    @map("new_value")
  reason       String?  @db.VarChar(500)
  ip           String?
  userAgent    String?  @map("user_agent") @db.VarChar(400)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([actorId])
  @@index([targetUserId])
  @@index([module, action])
  @@index([createdAt])
  @@map("audit_logs")
}

model ActivityLog {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  user        User         @relation("ActivitySubject", fields: [userId], references: [id], onDelete: Cascade)
  actorId     String?      @map("actor_id") @db.Uuid
  actor       User?        @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)
  kind        ActivityKind
  title       String       @db.VarChar(160)
  description String?      @db.VarChar(500)
  metadata    Json?
  ip          String?
  userAgent   String?      @map("user_agent") @db.VarChar(400)
  createdAt   DateTime     @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([kind, createdAt])
  @@index([createdAt])
  @@map("activity_logs")
}

/// In-app notifications only (no email/push/websocket in Phase 2).
model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      NotificationKind @default(SYSTEM)
  title     String           @db.VarChar(160)
  body      String           @db.VarChar(1000)
  metadata  Json?
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  @@index([userId, readAt])
  @@index([createdAt])
  @@map("notifications")
}

model KycSubmission {
  id                  String           @id @default(uuid()) @db.Uuid
  referenceId         String           @unique @map("reference_id") @db.VarChar(24)
  userId              String           @map("user_id") @db.Uuid
  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  status              KycStatus        @default(PENDING)
  country             String           @db.Char(2)
  dateOfBirth         DateTime         @map("date_of_birth") @db.Date
  nationality         String?          @db.Char(2)
  addressLine1        String?          @map("address_line1") @db.VarChar(120)
  city                String?          @db.VarChar(80)
  postalCode          String?          @map("postal_code") @db.VarChar(24)
  occupation          String?          @db.VarChar(80)
  primaryDocumentType KycDocumentType? @map("primary_document_type")
  riskLevel           KycRiskLevel     @default(LOW) @map("risk_level")
  riskScore           Int              @default(0) @map("risk_score")
  fraudFlag           Boolean          @default(false) @map("fraud_flag")
  documentQuality     Int?             @map("document_quality")
  assignedReviewerId  String?          @map("assigned_reviewer_id") @db.Uuid
  rejectionReason     String?          @map("rejection_reason") @db.VarChar(500)
  infoRequestMessage  String?          @map("info_request_message") @db.VarChar(1000)
  internalNotes       String?          @map("internal_notes") @db.VarChar(2000)
  submittedAt         DateTime?        @map("submitted_at")
  reviewedAt          DateTime?        @map("reviewed_at")
  expiresAt           DateTime?        @map("expires_at")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  documents KycDocument[]
  reviews   KycReview[]
  history   KycHistory[]

  @@index([userId, status])
  @@index([status, createdAt])
  @@index([country])
  @@index([riskLevel])
  @@index([assignedReviewerId])
  @@index([referenceId])
  @@map("kyc_submissions")
}

model KycDocument {
  id              String            @id @default(uuid()) @db.Uuid
  submissionId    String            @map("submission_id") @db.Uuid
  submission      KycSubmission     @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  documentType    KycDocumentType   @map("document_type")
  side            KycDocumentSide   @default(SINGLE)
  status          KycDocumentStatus @default(UPLOADED)
  storageKey      String            @map("storage_key") @db.VarChar(400)
  originalName    String            @map("original_name") @db.VarChar(200)
  mimeType        String            @map("mime_type") @db.VarChar(100)
  sizeBytes       Int               @map("size_bytes")
  checksumSha256  String            @map("checksum_sha256") @db.VarChar(64)
  virusScanStatus String            @default("PENDING") @map("virus_scan_status") @db.VarChar(32)
  deletedAt       DateTime?         @map("deleted_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  @@index([submissionId])
  @@index([checksumSha256])
  @@index([documentType])
  @@map("kyc_documents")
}

model KycReview {
  id              String            @id @default(uuid()) @db.Uuid
  submissionId    String            @map("submission_id") @db.Uuid
  submission      KycSubmission     @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewerId      String?           @map("reviewer_id") @db.Uuid
  reviewer        User?             @relation("KycReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  decision        KycReviewDecision
  reason          String?           @db.VarChar(1000)
  internalNotes   String?           @map("internal_notes") @db.VarChar(2000)
  riskLevel       KycRiskLevel?     @map("risk_level")
  riskScore       Int?              @map("risk_score")
  fraudFlag       Boolean?          @map("fraud_flag")
  documentQuality Int?              @map("document_quality")
  createdAt       DateTime          @default(now()) @map("created_at")

  @@index([submissionId, createdAt])
  @@index([reviewerId])
  @@map("kyc_reviews")
}

model KycHistory {
  id           String           @id @default(uuid()) @db.Uuid
  submissionId String           @map("submission_id") @db.Uuid
  submission   KycSubmission    @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  actorId      String?          @map("actor_id") @db.Uuid
  action       KycHistoryAction
  message      String?          @db.VarChar(1000)
  metadata     Json?
  createdAt    DateTime         @default(now()) @map("created_at")

  @@index([submissionId, createdAt])
  @@map("kyc_histories")
}

/// Cached balances — always derived from immutable ledger entries.
model Wallet {
  id               String     @id @default(uuid()) @db.Uuid
  userId           String     @map("user_id") @db.Uuid
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind             WalletKind
  currency         String     @default("USD") @db.Char(3)
  balance          Decimal    @default(0) @db.Decimal(20, 8)
  availableBalance Decimal    @default(0) @map("available_balance") @db.Decimal(20, 8)
  lockedBalance    Decimal    @default(0) @map("locked_balance") @db.Decimal(20, 8)
  pendingBalance   Decimal    @default(0) @map("pending_balance") @db.Decimal(20, 8)
  investedAmount   Decimal    @default(0) @map("invested_amount") @db.Decimal(20, 8)
  totalProfit      Decimal    @default(0) @map("total_profit") @db.Decimal(20, 8)
  totalDeposited   Decimal    @default(0) @map("total_deposited") @db.Decimal(20, 8)
  totalWithdrawn   Decimal    @default(0) @map("total_withdrawn") @db.Decimal(20, 8)
  version          Int        @default(0)
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  ledgerAccounts LedgerAccount[]
  ledgerEntries  LedgerEntry[]
  deposits       Deposit[]
  withdrawals    Withdrawal[]

  @@unique([userId, kind])
  @@index([userId])
  @@map("wallets")
}

model LedgerAccount {
  id          String            @id @default(uuid()) @db.Uuid
  code        String            @unique @db.VarChar(64)
  name        String            @db.VarChar(120)
  accountType LedgerAccountType @map("account_type")
  currency    String            @default("USD") @db.Char(3)
  userId      String?           @map("user_id") @db.Uuid
  user        User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletId    String?           @map("wallet_id") @db.Uuid
  wallet      Wallet?           @relation(fields: [walletId], references: [id], onDelete: Cascade)
  isSystem    Boolean           @default(false) @map("is_system")
  createdAt   DateTime          @default(now()) @map("created_at")

  entries LedgerEntry[]

  @@index([userId])
  @@index([walletId])
  @@map("ledger_accounts")
}

model Transaction {
  id             String            @id @default(uuid()) @db.Uuid
  referenceId    String            @unique @map("reference_id") @db.VarChar(32)
  userId         String            @map("user_id") @db.Uuid
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           TransactionType
  status         TransactionStatus @default(PENDING)
  amount         Decimal           @db.Decimal(20, 8)
  currency       String            @default("USD") @db.Char(3)
  description    String?           @db.VarChar(500)
  idempotencyKey String?           @unique @map("idempotency_key") @db.VarChar(120)
  createdById    String?           @map("created_by_id") @db.Uuid
  auditRef       String?           @map("audit_ref") @db.VarChar(80)
  metadata       Json?
  createdAt      DateTime          @default(now()) @map("created_at")
  postedAt       DateTime?         @map("posted_at")

  entries    LedgerEntry[]
  history    TransactionHistory[]
  deposit    Deposit?
  withdrawal Withdrawal?
  referralCredits  ReferralReward[] @relation("ReferralCreditTxn")
  referralRedeems  ReferralReward[] @relation("ReferralRedeemTxn")

  @@index([userId, createdAt])
  @@index([type, status])
  @@index([createdAt])
  @@map("transactions")
}

/// Immutable double-entry line. Never update or delete — reverse only.
model LedgerEntry {
  id             String          @id @default(uuid()) @db.Uuid
  transactionId  String          @map("transaction_id") @db.Uuid
  transaction    Transaction     @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  accountId      String          @map("account_id") @db.Uuid
  account        LedgerAccount   @relation(fields: [accountId], references: [id], onDelete: Restrict)
  walletId       String?         @map("wallet_id") @db.Uuid
  wallet         Wallet?         @relation(fields: [walletId], references: [id], onDelete: SetNull)
  direction      LedgerDirection
  amount         Decimal         @db.Decimal(20, 8)
  signedAmount   Decimal         @map("signed_amount") @db.Decimal(20, 8)
  entryType      LedgerEntryType @map("entry_type")
  balanceBefore  Decimal?        @map("balance_before") @db.Decimal(20, 8)
  balanceAfter   Decimal?        @map("balance_after") @db.Decimal(20, 8)
  description    String?         @db.VarChar(500)
  referenceType  String?         @map("reference_type") @db.VarChar(40)
  referenceId    String?         @map("reference_id") @db.Uuid
  idempotencyKey String?         @unique @map("idempotency_key") @db.VarChar(160)
  createdById    String?         @map("created_by_id") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at")

  @@index([transactionId])
  @@index([accountId])
  @@index([walletId, createdAt])
  @@index([referenceType, referenceId])
  @@index([createdAt])
  @@map("ledger_entries")
}

model PaymentMethod {
  id             String            @id @default(uuid()) @db.Uuid
  name           String            @db.VarChar(80)
  type           PaymentMethodType
  instructions   String            @db.VarChar(2000)
  /// @deprecated Prefer normalized upiDetails / bankDetails / walletAddresses. Kept for safe migration.
  accountDetails Json              @default("{}") @map("account_details")
  network        String?           @db.VarChar(40)
  logoKey        String?           @map("logo_key") @db.VarChar(400)
  minAmount      Decimal           @default(1) @map("min_amount") @db.Decimal(20, 8)
  maxAmount      Decimal?          @map("max_amount") @db.Decimal(20, 8)
  feePct         Decimal           @default(0) @map("fee_pct") @db.Decimal(10, 6)
  processingTime String?           @map("processing_time") @db.VarChar(80)
  priority       Int               @default(100)
  isActive       Boolean           @default(true) @map("is_active")
  deletedAt      DateTime?         @map("deleted_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  upiDetails      PaymentMethodUpiDetails?
  bankDetails     PaymentMethodBankDetails?
  walletAddresses WalletAddress[]
  deposits        Deposit[]

  @@index([isActive, priority])
  @@index([type])
  @@map("payment_methods")
}

model PaymentMethodUpiDetails {
  paymentMethodId   String        @id @map("payment_method_id") @db.Uuid
  paymentMethod     PaymentMethod @relation(fields: [paymentMethodId], references: [id], onDelete: Cascade)
  upiId             String        @map("upi_id") @db.VarChar(120)
  accountHolderName String        @map("account_holder_name") @db.VarChar(120)
  qrCodeKey         String?       @map("qr_code_key") @db.VarChar(400)
