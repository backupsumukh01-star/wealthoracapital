model PlatformSetting {
  id              String   @id @default(uuid()) @db.Uuid
  companyName     String   @default("Growzy") @map("company_name") @db.VarChar(120)
  supportEmail    String   @default("support@growzy.com") @map("support_email") @db.VarChar(160)
  supportPhone    String?  @map("support_phone") @db.VarChar(40)
  defaultCurrency String   @default("USD") @map("default_currency") @db.Char(3)
  timezone        String   @default("UTC") @db.VarChar(60)
  maintenanceMode Boolean  @default(false) @map("maintenance_mode")
  networks        Json     @default("[]")
  coins           Json     @default("[]")
  minDeposit      Decimal  @default(1) @map("min_deposit") @db.Decimal(20, 8)
  maxDeposit      Decimal  @default(1000000) @map("max_deposit") @db.Decimal(20, 8)
  minWithdrawal   Decimal  @default(20) @map("min_withdrawal") @db.Decimal(20, 8)
  maxWithdrawal   Decimal  @default(1000000) @map("max_withdrawal") @db.Decimal(20, 8)
  /** Live desk USD→INR rate (admin-editable). Ledger remains USD. Kept in sync with currencyRates.INR. */
  usdInrRate      Decimal  @default(93) @map("usd_inr_rate") @db.Decimal(20, 8)
  /**
   * Units of each currency per 1 USD (admin-editable). Example: { "USD":"1", "INR":"93", "EUR":"0.92" }.
   * Display conversion only — never rewrites historical ledger/deposit/withdrawal amounts.
   */
  currencyRates   Json     @default("{}") @map("currency_rates")
  /** Referral commission percent of each approved referred deposit (snapshot onto each reward). */
  referralPercent     Decimal @default(5) @map("referral_percent") @db.Decimal(10, 4)
  /** Per-reward unlock period in days after the source deposit is approved. */
  referralUnlockDays  Int     @default(30) @map("referral_unlock_days")
  /** Master switch — rewards are not created while false. */
  referralEnabled     Boolean @default(false) @map("referral_enabled")
  updatedById     String?  @map("updated_by_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}

