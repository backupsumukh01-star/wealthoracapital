  qrCodeKey         String?       @map("qr_code_key") @db.VarChar(400)
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  @@map("payment_method_bank_details")
}

/// Crypto deposit wallets (coin + network + address). Multiple rows per CRYPTO method.
model WalletAddress {
  id              String         @id @default(uuid()) @db.Uuid
  paymentMethodId String?        @map("payment_method_id") @db.Uuid
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  label           String         @db.VarChar(80)
  coin            String         @default("USDT") @db.VarChar(20)
  network         String         @db.VarChar(40)
  address         String         @db.VarChar(200)
  memo            String?        @db.VarChar(120)
  instructions    String?        @db.VarChar(2000)
  qrCodeKey       String?        @map("qr_code_key") @db.VarChar(400)
  minAmount       Decimal?       @map("min_amount") @db.Decimal(20, 8)
  maxAmount       Decimal?       @map("max_amount") @db.Decimal(20, 8)
  sortOrder       Int            @default(100) @map("sort_order")
  isDefault       Boolean        @default(false) @map("is_default")
  isActive        Boolean        @default(true) @map("is_active")
  deletedAt       DateTime?      @map("deleted_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  @@index([network, isActive])
  @@index([coin, network, isActive])
  @@index([paymentMethodId, sortOrder])
  @@map("wallet_addresses")
}

model PayoutMethod {
  id            String            @id @default(uuid()) @db.Uuid
  userId        String            @map("user_id") @db.Uuid
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  label         String            @db.VarChar(80)
  type          PaymentMethodType
  details       Json              @default("{}")
  maskedDetails String            @map("masked_details") @db.VarChar(160)
  isDefault     Boolean           @default(false) @map("is_default")
  isVerified    Boolean           @default(false) @map("is_verified")
  deletedAt     DateTime?         @map("deleted_at")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  withdrawals Withdrawal[]

  @@index([userId])
  @@map("payout_methods")
}

model Deposit {
  id              String        @id @default(uuid()) @db.Uuid
  reference       String        @unique @db.VarChar(32)
  userId          String        @map("user_id") @db.Uuid
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletId        String        @map("wallet_id") @db.Uuid
  wallet          Wallet        @relation(fields: [walletId], references: [id], onDelete: Restrict)
  paymentMethodId String        @map("payment_method_id") @db.Uuid
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  transactionId   String?       @unique @map("transaction_id") @db.Uuid
  transaction     Transaction?  @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  amount          Decimal       @db.Decimal(20, 8)
  /** INR snapshot at submission using platform desk rate (whole rupees). */
  amountInr       Decimal?      @map("amount_inr") @db.Decimal(20, 8)
  fee             Decimal       @default(0) @db.Decimal(20, 8)
  creditedAmount  Decimal?      @map("credited_amount") @db.Decimal(20, 8)
  currency        String        @default("USD") @db.Char(3)
  /** Holding period in days applied when the deposit is approved. */
  lockDays        Int           @default(10) @map("lock_days")
  /**
   * When credited funds become eligible for withdrawal.
   * Null = no lock (legacy / not yet approved). Set on APPROVED = reviewedAt + lockDays.
   */
  fundsUnlockAt   DateTime?     @map("funds_unlock_at")
  status          DepositStatus @default(PENDING)
  userReference   String?       @map("user_reference") @db.VarChar(120)
  txHash          String?       @map("tx_hash") @db.VarChar(120)
  notes           String?       @db.VarChar(2000)
  submissionDetails Json?       @map("submission_details")
  proofKey        String?       @map("proof_key") @db.VarChar(400)
  proofImageUrl   String?       @map("proof_image_url") @db.VarChar(800)
  proofChecksum   String?       @map("proof_checksum") @db.VarChar(64)
  proofUploadedAt DateTime?     @map("proof_uploaded_at")
  rejectionReason String?       @map("rejection_reason") @db.VarChar(500)
  internalNotes   String?       @map("internal_notes") @db.VarChar(2000)
  idempotencyKey  String        @unique @map("idempotency_key") @db.VarChar(120)
  reviewedById    String?       @map("reviewed_by_id") @db.Uuid
  reviewedAt      DateTime?     @map("reviewed_at")
  expiresAt       DateTime?     @map("expires_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  reviews FinanceReview[]
  queue   ApprovalQueue?
  webhookEvents PaymentWebhookEvent[]
  referralReward ReferralReward?

  @@unique([txHash])
  @@index([userId, status])
  @@index([status, createdAt])
  @@index([proofChecksum])
  @@map("deposits")
}

enum ReferralRewardStatus {
  LOCKED
  AVAILABLE
  REDEEMED
  CANCELLED
}

/// Per-deposit referral commission for the referrer. Unlock dates are per-row (not wallet aggregates).
model ReferralReward {
  id                     String               @id @default(uuid()) @db.Uuid
  referrerId             String               @map("referrer_id") @db.Uuid
  referrer               User                 @relation("ReferralReferrer", fields: [referrerId], references: [id], onDelete: Cascade)
  refereeId              String               @map("referee_id") @db.Uuid
  referee                User                 @relation("ReferralReferee", fields: [refereeId], references: [id], onDelete: Cascade)
  sourceDepositId        String               @unique @map("source_deposit_id") @db.Uuid
  sourceDeposit          Deposit              @relation(fields: [sourceDepositId], references: [id], onDelete: Restrict)
  sourceAmount           Decimal              @map("source_amount") @db.Decimal(20, 8)
  rewardAmount           Decimal              @map("reward_amount") @db.Decimal(20, 8)
  percentApplied         Decimal              @map("percent_applied") @db.Decimal(10, 4)
  status                 ReferralRewardStatus @default(LOCKED)
  unlockAt               DateTime             @map("unlock_at")
  creditedTransactionId  String?              @map("credited_transaction_id") @db.Uuid
  creditedTransaction    Transaction?         @relation("ReferralCreditTxn", fields: [creditedTransactionId], references: [id], onDelete: SetNull)
  redeemedTransactionId  String?              @unique @map("redeemed_transaction_id") @db.Uuid
  redeemedTransaction    Transaction?         @relation("ReferralRedeemTxn", fields: [redeemedTransactionId], references: [id], onDelete: SetNull)
  redeemedAt             DateTime?            @map("redeemed_at")
  createdAt              DateTime             @default(now()) @map("created_at")
  updatedAt              DateTime             @updatedAt @map("updated_at")

  @@index([referrerId, status])
  @@index([unlockAt, status])
  @@map("referral_rewards")
}

model Withdrawal {
  id                  String           @id @default(uuid()) @db.Uuid
  reference           String           @unique @db.VarChar(32)
  userId              String           @map("user_id") @db.Uuid
  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)
