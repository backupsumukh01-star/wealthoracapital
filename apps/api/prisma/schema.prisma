// Growzy / Meridian FX — Prisma schema
// Phase 1: identity & auth
// Phase 2: profiles, audit, activity, notifications

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum StaffRole {
  SUPER_ADMIN
  ADMIN
  FINANCE
  SUPPORT
  KYC
  CONTENT
  VIEWER
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  BLOCKED
  CLOSED
  ARCHIVED
}

enum KycStatus {
  NOT_STARTED
  PENDING
  SUBMITTED
  UNDER_REVIEW
  NEED_MORE_INFO
  APPROVED
  REJECTED
  EXPIRED
  SUSPENDED
}

enum KycDocumentType {
  PASSPORT
  NATIONAL_ID
  DRIVING_LICENSE
  RESIDENCE_PERMIT
  PROOF_OF_ADDRESS
  SELFIE
  BANK_STATEMENT
  UTILITY_BILL
}

enum KycDocumentSide {
  FRONT
  BACK
  SINGLE
}

enum KycDocumentStatus {
  UPLOADED
  VERIFIED
  REJECTED
  REPLACED
}

enum KycRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum KycReviewDecision {
  APPROVE
  REJECT
  REQUEST_INFORMATION
  EXPIRE
  REOPEN
  SUSPEND
}

enum KycHistoryAction {
  CREATED
  UPDATED
  DOCUMENT_UPLOADED
  DOCUMENT_DELETED
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  INFO_REQUESTED
  EXPIRED
  REOPENED
  SUSPENDED
  ASSIGNED
  NOTE_ADDED
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  EMAIL_CHANGE
}

enum ActivityKind {
  LOGIN
  LOGOUT
  PASSWORD_CHANGE
  EMAIL_CHANGE
  PROFILE_UPDATE
  ADMIN_ACTION
  ACCOUNT_STATUS_CHANGE
  SESSION_TERMINATED
  AVATAR_UPDATE
  REGISTRATION
  KYC_SUBMITTED
  KYC_APPROVED
  KYC_REJECTED
  KYC_INFO_REQUESTED
  KYC_EXPIRED
  KYC_SUSPENDED
  KYC_REOPENED
}

enum NotificationKind {
  SYSTEM
  SECURITY
  ACCOUNT
  ADMIN
}

model User {
  id                String     @id @default(uuid()) @db.Uuid
  email             String     @unique @db.Citext
  emailVerifiedAt   DateTime?  @map("email_verified_at")
  passwordHash      String?    @map("password_hash")
  firstName         String     @map("first_name") @db.VarChar(60)
  lastName          String     @map("last_name") @db.VarChar(60)
  phone             String?    @db.VarChar(24)
  country           String?    @db.Char(2)
  timezone          String     @default("UTC")
  avatarKey         String?    @map("avatar_key")
  role              Role       @default(USER)
  staffRole         StaffRole? @map("staff_role")
  status            UserStatus @default(PENDING_VERIFICATION)
  kycStatus         KycStatus  @default(NOT_STARTED) @map("kyc_status")

  twoFactorSecret   String?    @map("two_factor_secret")
  twoFactorEnabled  Boolean    @default(false) @map("two_factor_enabled")
  failedLoginCount  Int        @default(0) @map("failed_login_count")
  lockedUntil       DateTime?  @map("locked_until")
  lastLoginAt       DateTime?  @map("last_login_at")
  lastLoginIp       String?    @map("last_login_ip")
  passwordChangedAt DateTime?  @map("password_changed_at")

  termsAcceptedAt   DateTime?  @map("terms_accepted_at")
  riskAcceptedAt    DateTime?  @map("risk_accepted_at")
  marketingOptIn    Boolean    @default(false) @map("marketing_opt_in")

  referralCode      String?    @unique @map("referral_code") @db.VarChar(16)
  referredById      String?    @map("referred_by_id") @db.Uuid
  referredBy        User?      @relation("Referrals", fields: [referredById], references: [id])
  referrals         User[]     @relation("Referrals")

  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")
  deletedAt         DateTime?  @map("deleted_at")

  // UserSession — existing Session model (refresh-token sessions)
  sessions              Session[]
  verificationTokens    VerificationToken[]
  profile               UserProfile?
  auditLogsAsActor      AuditLog[]    @relation("AuditActor")
  auditLogsAsTarget     AuditLog[]    @relation("AuditTarget")
  activityLogs          ActivityLog[] @relation("ActivitySubject")
  activityLogsAsActor   ActivityLog[] @relation("ActivityActor")
  notifications         Notification[]
  kycSubmissions        KycSubmission[]
  kycReviewsAssigned    KycReview[]     @relation("KycReviewer")

  @@index([status])
  @@index([role])
  @@index([staffRole])
  @@index([kycStatus])
  @@index([createdAt])
  @@index([country])
  @@index([phone])
  @@map("users")
}

/// Refresh-token session store (UserSession in product language).
model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique @map("refresh_token_hash")
  familyId         String    @map("family_id") @db.Uuid
  userAgent        String?   @map("user_agent") @db.VarChar(400)
  ip               String?
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  replacedById     String?   @map("replaced_by_id") @db.Uuid
  lastUsedAt       DateTime  @default(now()) @map("last_used_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("sessions")
}

model VerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  type      TokenType
  payload   Json?
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, type])
  @@map("verification_tokens")
}

model UserProfile {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @map("user_id") @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  addressLine1 String? @map("address_line1") @db.VarChar(120)
  addressLine2 String? @map("address_line2") @db.VarChar(120)
  city        String?  @db.VarChar(80)
  state       String?  @db.VarChar(80)
  postalCode  String?  @map("postal_code") @db.VarChar(24)
  language    String   @default("en") @db.VarChar(10)
  bio         String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("user_profiles")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  targetUserId String? @map("target_user_id") @db.Uuid
  targetUser User?    @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  action     String   @db.VarChar(80)
  module     String   @db.VarChar(80)
  oldValue   Json?    @map("old_value")
  newValue   Json?    @map("new_value")
  reason     String?  @db.VarChar(500)
  ip         String?
  userAgent  String?  @map("user_agent") @db.VarChar(400)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([actorId])
  @@index([targetUserId])
  @@index([module, action])
  @@index([createdAt])
  @@map("audit_logs")
}

model ActivityLog {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  user        User         @relation("ActivitySubject", fields: [userId], references: [id], onDelete: Cascade)
  actorId     String?      @map("actor_id") @db.Uuid
  actor       User?        @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)
  kind        ActivityKind
  title       String       @db.VarChar(160)
  description String?      @db.VarChar(500)
  metadata    Json?
  ip          String?
  userAgent   String?      @map("user_agent") @db.VarChar(400)
  createdAt   DateTime     @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([kind, createdAt])
  @@index([createdAt])
  @@map("activity_logs")
}

/// In-app notifications only (no email/push/websocket in Phase 2).
model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      NotificationKind @default(SYSTEM)
  title     String           @db.VarChar(160)
  body      String           @db.VarChar(1000)
  metadata  Json?
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  @@index([userId, readAt])
  @@index([createdAt])
  @@map("notifications")
}

model KycSubmission {
  id                 String        @id @default(uuid()) @db.Uuid
  referenceId        String        @unique @map("reference_id") @db.VarChar(24)
  userId             String        @map("user_id") @db.Uuid
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  status             KycStatus     @default(PENDING)
  country            String        @db.Char(2)
  dateOfBirth        DateTime      @map("date_of_birth") @db.Date
  nationality        String?       @db.Char(2)
  addressLine1       String?       @map("address_line1") @db.VarChar(120)
  city               String?       @db.VarChar(80)
  postalCode         String?       @map("postal_code") @db.VarChar(24)
  occupation         String?       @db.VarChar(80)
  primaryDocumentType KycDocumentType? @map("primary_document_type")
  riskLevel          KycRiskLevel  @default(LOW) @map("risk_level")
  riskScore          Int           @default(0) @map("risk_score")
  fraudFlag          Boolean       @default(false) @map("fraud_flag")
  documentQuality    Int?          @map("document_quality")
  assignedReviewerId String?       @map("assigned_reviewer_id") @db.Uuid
  rejectionReason    String?       @map("rejection_reason") @db.VarChar(500)
  infoRequestMessage String?       @map("info_request_message") @db.VarChar(1000)
  internalNotes      String?       @map("internal_notes") @db.VarChar(2000)
  submittedAt        DateTime?     @map("submitted_at")
  reviewedAt         DateTime?     @map("reviewed_at")
  expiresAt          DateTime?     @map("expires_at")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  documents KycDocument[]
  reviews   KycReview[]
  history   KycHistory[]

  @@index([userId, status])
  @@index([status, createdAt])
  @@index([country])
  @@index([riskLevel])
  @@index([assignedReviewerId])
  @@index([referenceId])
  @@map("kyc_submissions")
}

model KycDocument {
  id           String            @id @default(uuid()) @db.Uuid
  submissionId String            @map("submission_id") @db.Uuid
  submission   KycSubmission     @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  documentType KycDocumentType   @map("document_type")
  side         KycDocumentSide   @default(SINGLE)
  status       KycDocumentStatus @default(UPLOADED)
  storageKey   String            @map("storage_key") @db.VarChar(400)
  originalName String            @map("original_name") @db.VarChar(200)
  mimeType     String            @map("mime_type") @db.VarChar(100)
  sizeBytes    Int               @map("size_bytes")
  checksumSha256 String          @map("checksum_sha256") @db.VarChar(64)
  virusScanStatus String         @default("PENDING") @map("virus_scan_status") @db.VarChar(32)
  deletedAt    DateTime?         @map("deleted_at")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  @@index([submissionId])
  @@index([checksumSha256])
  @@index([documentType])
  @@map("kyc_documents")
}

model KycReview {
  id             String            @id @default(uuid()) @db.Uuid
  submissionId   String            @map("submission_id") @db.Uuid
  submission     KycSubmission     @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewerId     String?           @map("reviewer_id") @db.Uuid
  reviewer       User?             @relation("KycReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  decision       KycReviewDecision
  reason         String?           @db.VarChar(1000)
  internalNotes  String?           @map("internal_notes") @db.VarChar(2000)
  riskLevel      KycRiskLevel?     @map("risk_level")
  riskScore      Int?              @map("risk_score")
  fraudFlag      Boolean?          @map("fraud_flag")
  documentQuality Int?             @map("document_quality")
  createdAt      DateTime          @default(now()) @map("created_at")

  @@index([submissionId, createdAt])
  @@index([reviewerId])
  @@map("kyc_reviews")
}

model KycHistory {
  id           String           @id @default(uuid()) @db.Uuid
  submissionId String           @map("submission_id") @db.Uuid
  submission   KycSubmission    @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  actorId      String?          @map("actor_id") @db.Uuid
  action       KycHistoryAction
  message      String?          @db.VarChar(1000)
  metadata     Json?
  createdAt    DateTime         @default(now()) @map("created_at")

  @@index([submissionId, createdAt])
  @@map("kyc_histories")
}
