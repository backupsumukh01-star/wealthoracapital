{
  "name": "@meridian/api",
  "version": "0.1.0",
  "private": true,
  "description": "Wealthora Capital / Meridian FX Express API — Phase 1 auth + Phase 2 user/admin foundation",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "worker": "tsx src/worker.ts",
    "worker:start": "node dist/worker.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run src",
    "test:integration": "vitest run tests/integration tests/security",
    "stress:health": "node ./scripts/stress-health.mjs",
    "clean": "rimraf dist .turbo coverage",
    "db:generate": "prisma generate --schema=./prisma/schema.prisma",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "node ./scripts/migrate-deploy-safe.mjs",
    "db:migrate:deploy:raw": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "admin:promote": "node scripts/promote-admin.mjs",
    "db:seed:demo": "tsx scripts/seed-demo-backtest.mjs",
    "db:push": "prisma db push",
    "openapi:generate": "node ../../scripts/generate-openapi.mjs",
    "postinstall": "prisma generate --schema=./prisma/schema.prisma",
    "render:build": "prisma generate --schema=./prisma/schema.prisma && tsup"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.758.0",
    "@meridian/shared": "workspace:*",
    "@prisma/client": "^6.5.0",
    "@resvg/resvg-js": "^2.6.2",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.0.8",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "decimal.js": "^10.4.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "prisma": "^6.5.0",
    "prom-client": "^15.1.3",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@meridian/config": "workspace:*",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.5",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.18.0",
    "pino-pretty": "^13.0.0",
    "playwright": "1.49.1",
    "rimraf": "^6.0.1",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "typescript-eslint": "^8.21.0",
    "vitest": "^4.1.10"
  }
}
