# ---------------------------------------------------------------------------
# apps/web — public configuration (Render / local)
#
# Only NEXT_PUBLIC_* variables reach the browser. Nothing secret belongs here.
# On Render, set these as service env vars (build-time for Next.js).
# ---------------------------------------------------------------------------

# Express API base including /api/v1 (production HTTPS, no localhost)
NEXT_PUBLIC_API_URL=https://api.wealthoracapital.net/api/v1

# Canonical site origin — metadata, sitemap, OG, OAuth return paths
NEXT_PUBLIC_SITE_URL=https://wealthoracapital.net

NEXT_PUBLIC_PLATFORM_NAME=Wealthora Capital
NEXT_PUBLIC_SUPPORT_EMAIL=update@wealthoracapital.net

NEXT_PUBLIC_ENABLE_REFERRALS=false
NEXT_PUBLIC_ENABLE_ROUTE_GUARDS=true
