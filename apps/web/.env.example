# ---------------------------------------------------------------------------
# apps/web — public configuration
#
# Only NEXT_PUBLIC_* variables reach the browser. Nothing secret belongs in this
# file or in this app (docs/14 §10 item 83).
# ---------------------------------------------------------------------------

# Where the Express API lives. In production Nginx proxies /api on the same
# origin, so cookies stay first-party.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Canonical site origin — used for metadata, sitemap and OG image URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Branding shown before the platform settings are loaded from the API.
NEXT_PUBLIC_PLATFORM_NAME=Growzy
NEXT_PUBLIC_SUPPORT_EMAIL=support@growzy.com

# Feature flags for routes that exist but are not shipped in v1.
NEXT_PUBLIC_ENABLE_REFERRALS=false

# When true (default unless set to false), middleware redirects unauthenticated
# visitors away from dashboard / wallet / settings / onboarding.
# Require session cookie for protected routes (demo cookie set on login).
NEXT_PUBLIC_ENABLE_ROUTE_GUARDS=true
