# Growzy — Production environment template (Render / PaaS)
# Prefer env.render.example + render.yaml for Render.
# Never commit real secrets.

NODE_ENV=production
APP_ENV=production
APP_NAME=Growzy
# PORT is provided by the platform

APP_URL=https://growzycapital.com
API_URL=https://api.growzycapital.com

DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

JWT_ACCESS_SECRET=replace-with-64-char-random-access-secret!!
JWT_REFRESH_SECRET=replace-with-64-char-random-refresh-secret!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=growzy
JWT_AUDIENCE=growzy-web

COOKIE_DOMAIN=.growzycapital.com
COOKIE_SECURE=true
CORS_ORIGIN=https://growzycapital.com

BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=20

EMAIL_TRANSPORT=resend
RESEND_API_KEY=
SMTP_FROM_NAME=Growzy
SMTP_FROM_ADDRESS=noreply@growzycapital.com

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.growzycapital.com/api/v1/auth/google/callback

CACHE_DRIVER=memory
JOB_DRIVER=memory
RATE_LIMIT_STORE=memory
REDIS_URL=
REDIS_REQUIRED=false

LOG_LEVEL=info
# Prefer STORAGE_DRIVER=s3 in multi-instance production. Local disk is single-node only.
UPLOAD_ROOT=/var/data/uploads
STORAGE_DRIVER=local
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=

ENABLE_API_DOCS=true
CSRF_PROTECTION=true
METRICS_ENABLED=true

# Frontend (set on growzy-web; inlined at build time)
NEXT_PUBLIC_API_URL=https://api.growzycapital.com/api/v1
NEXT_PUBLIC_SITE_URL=https://growzycapital.com
NEXT_PUBLIC_PLATFORM_NAME=Growzy
NEXT_PUBLIC_SUPPORT_EMAIL=support@growzycapital.com
NEXT_PUBLIC_ENABLE_REFERRALS=false
NEXT_PUBLIC_ENABLE_ROUTE_GUARDS=true
