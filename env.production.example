# Growzy — Production / Staging environment template
# Copy to .env.production or .env.staging (never commit real secrets)

NODE_ENV=production
APP_ENV=production
PORT=4000
APP_NAME=Growzy
APP_URL=https://app.example.com
API_URL=https://api.example.com

DATABASE_URL=postgresql://USER:PASSWORD@postgres:5432/meridian?schema=public
POSTGRES_USER=meridian
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=meridian
REDIS_PASSWORD=change-me-redis

REDIS_URL=redis://:change-me-redis@redis:6379
REDIS_REQUIRED=true
CACHE_DRIVER=redis
JOB_DRIVER=bullmq
RATE_LIMIT_STORE=redis

JWT_ACCESS_SECRET=replace-with-64-char-random-access-secret!!
JWT_REFRESH_SECRET=replace-with-64-char-random-refresh-secret!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=growzy
JWT_AUDIENCE=growzy-web

COOKIE_DOMAIN=.example.com
COOKIE_SECURE=true
CORS_ORIGIN=https://app.example.com

BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=20

EMAIL_TRANSPORT=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Growzy
SMTP_FROM_ADDRESS=noreply@example.com

LOG_LEVEL=info
UPLOAD_ROOT=/app/uploads
STORAGE_DRIVER=local

SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
METRICS_ENABLED=true

WORKER_GROUP=all
WORKER_CONCURRENCY=4
BACKUP_RETENTION_DAYS=14
