# Growzy monorepo — copy app env files before running on a VPS.
#
# Web:
#   cp apps/web/.env.example apps/web/.env.local
# API (when backend is live):
#   cp apps/api/.env.example apps/api/.env
#
# Never commit real secrets.

# Optional root convenience (not read by Next/Express directly)
NODE_VERSION=22
PNPM_VERSION=9
